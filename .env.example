SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SECRET_KEY=your-flask-secret-key-change-this
FLASK_ENV=development

# Render: set the same variables in Dashboard → Environment (do not commit .env)

# Setup order:
# 1. Run supabase_schema.sql in Supabase SQL Editor
# 2. Run bootstrap_super_admin.sql (first Super Admin only)
# 3. Create storage buckets: assessment-scripts, assessment-evidence (public)
# 4. Login: superadmin@ttieportfolio.ac.ke / Admin@1234 — change password immediately
